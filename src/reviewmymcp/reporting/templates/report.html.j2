<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>MCP Audit Report — {{ report.server_meta.server_name }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a2e; background: #fafafa; }
  h1 { border-bottom: 2px solid #333; padding-bottom: 0.5rem; }
  .grade { display: inline-block; font-size: 2rem; font-weight: bold; padding: 0.25rem 0.75rem; border-radius: 6px; color: white; }
  .grade-A { background: #2ecc71; } .grade-B { background: #3498db; } .grade-C { background: #f39c12; } .grade-D { background: #e74c3c; } .grade-F { background: #c0392b; }
  table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
  th, td { text-align: left; padding: 0.5rem; border-bottom: 1px solid #ddd; }
  th { background: #f0f0f0; }
  .severity-critical { color: #c0392b; font-weight: bold; } .severity-high { color: #e74c3c; } .severity-medium { color: #f39c12; } .severity-low { color: #3498db; }
  .finding { margin: 1rem 0; padding: 0.75rem; background: white; border-left: 4px solid #ddd; border-radius: 4px; }
  .finding-critical { border-left-color: #c0392b; } .finding-high { border-left-color: #e74c3c; } .finding-medium { border-left-color: #f39c12; }
  .remediation { color: #666; font-style: italic; margin-top: 0.25rem; }
  details { margin: 0.5rem 0; }
  summary { cursor: pointer; font-weight: bold; }
  .meta { color: #666; font-size: 0.9rem; }
</style>
</head>
<body>
<h1>MCP Server Audit Report</h1>
<div class="meta">
  <p>Server: <strong>{{ report.server_meta.server_name }}</strong> v{{ report.server_meta.server_version }}</p>
  <p>Protocol: {{ report.server_meta.protocol_version }} | Events: {{ report.total_events }} | Sessions: {{ report.total_sessions }}{% if report.tool_count %} | Tools: {{ report.tool_count }}{% endif %}{% if report.call_count %} | Calls: {{ report.call_count }}{% endif %}</p>
  {% if report.server_meta.auth.scopes_used or report.server_meta.auth.scopes_required %}
  <p>Auth scopes used: {{ report.server_meta.auth.scopes_used|join(', ') or 'unknown' }}{% if report.server_meta.auth.scopes_required %} | Tools with required scopes: {{ report.server_meta.auth.scopes_required|length }}{% endif %}</p>
  {% endif %}
  {% if report.server_meta.runtime.reproducible_command %}
  <p>Reproduce: <code>{{ report.server_meta.runtime.reproducible_command }}</code>{% if report.server_meta.runtime.package_name and report.server_meta.runtime.package_version %} | Package: {{ report.server_meta.runtime.package_name }}@{{ report.server_meta.runtime.package_version }}{% endif %}</p>
  {% endif %}
  <p>Date: {{ report.timestamp.strftime('%Y-%m-%d %H:%M UTC') }}</p>
</div>

<h2>Dimension Scores</h2>
<table>
  <thead><tr><th>Dimension</th><th>Score</th><th>Grade</th><th>Critical</th><th>High</th><th>Medium</th><th>Low</th><th>Skipped</th></tr></thead>
  <tbody>
  {% for ds in report.dimension_scores|sort(attribute='dimension') %}
  <tr>
    <td>{{ ds.dimension }}</td>
    <td>{{ '%.0f'|format(ds.score) }}</td>
    <td><span class="grade grade-{{ ds.grade.value }}" style="font-size:1rem;padding:0.1rem 0.4rem;">{{ ds.grade.value }}</span></td>
    <td>{{ ds.critical_count or '-' }}</td>
    <td>{{ ds.high_count or '-' }}</td>
    <td>{{ ds.medium_count or '-' }}</td>
    <td>{{ ds.low_count or '-' }}</td>
    <td>{{ ds.checks_skipped|length or '-' }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>

{% set all_skipped = [] %}
{% for ds in report.dimension_scores %}{% for sc in ds.checks_skipped %}{% if all_skipped.append((ds.dimension, sc)) %}{% endif %}{% endfor %}{% endfor %}
{% if all_skipped %}
<h3>Skipped Checks</h3>
<table>
  <thead><tr><th>Check</th><th>Reason</th></tr></thead>
  <tbody>
  {% for dim, sc in all_skipped %}
  <tr><td>{{ sc.check_id }}</td><td>{{ sc.reason }}</td></tr>
  {% endfor %}
  </tbody>
</table>
{% endif %}

<h2>Top Findings</h2>
{% for finding in report.top_findings %}
<div class="finding finding-{{ finding.severity.value }}">
  <span class="severity-{{ finding.severity.value }}">[{{ finding.severity.value|upper }}]</span>
  <strong>{{ finding.check_id }}</strong>
  <p>{{ finding.title }}</p>
  <p>{{ finding.description }}</p>
  {% if finding.remediation %}<p class="remediation">Fix: {{ finding.remediation }}</p>{% endif %}
</div>
{% endfor %}

{% for ds in report.dimension_scores|sort(attribute='dimension') %}
{% if ds.findings %}
<details>
  <summary>{{ ds.dimension }} — {{ ds.findings|length }} findings</summary>
  {% for finding in ds.findings %}
  <div class="finding finding-{{ finding.severity.value }}">
    <span class="severity-{{ finding.severity.value }}">[{{ finding.severity.value|upper }}]</span>
    <strong>{{ finding.check_id }}</strong>
    <p>{{ finding.title }}</p>
    {% if finding.remediation %}<p class="remediation">Fix: {{ finding.remediation }}</p>{% endif %}
  </div>
  {% endfor %}
</details>
{% endif %}
{% endfor %}

<hr>
<p class="meta">Generated by <a href="https://github.com/reviewmymcp/reviewmymcp">reviewmymcp</a> v0.1.0</p>
</body>
</html>
